	"item": [
		{
			"name": "Is Valid ISBN13 Number",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response = pm.response.text();",
							"",
							"// Test 1. Status code is 200",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"// Test 2. Response body is not empty",
							"pm.test(\"Response body is not empty\", function () {",
							"    pm.expect(response).to.not.eql(\"\");",
							"});",
							"",
							"// Test 3. Response contains SOAP Envelope",
							"pm.test(\"Response contains SOAP Envelope\", function () {",
							"    pm.expect(response).to.include(\"soap:Envelope\");",
							"});",
							"",
							"// Test 4. Response contains SOAP Body",
							"pm.test(\"Response contains SOAP Body\", function () {",
							"    pm.expect(response).to.include(\"soap:Body\");",
							"});",
							"",
							"// Test 5. Response contains IsValidISBN13Response",
							"pm.test(\"Response contains IsValidISBN13Response\", function () {",
							"    pm.expect(response).to.include(\"IsValidISBN13Response\");",
							"});",
							"",
							"// Test 6. Response contains IsValidISBN13Result",
							"pm.test(\"Response contains IsValidISBN13Result\", function () {",
							"    pm.expect(response).to.include(\"IsValidISBN13Result\");",
							"});",
							"",
							"// Test 7. ISBN13 is valid",
							"pm.test(\"ISBN13 is valid\", function () {",
							"    pm.expect(response).to.include(",
							"        \"<m:IsValidISBN13Result>true</m:IsValidISBN13Result>\"",
							"    );",
							"});",
							"",
							"// Test 8. Content-Type header exists",
							"pm.test(\"Content-Type header exists\", function () {",
							"    pm.expect(",
							"        pm.response.headers.has(\"Content-Type\")",
							"    ).to.eql(true);",
							"});",
							"",
							"// Test 9. Content-Type is XML",
							"pm.test(\"Content-Type is XML\", function () {",
							"    pm.expect(",
							"        pm.response.headers.get(\"Content-Type\")",
							"    ).to.eql(\"text/xml; charset=utf-8\");",
							"});",
							"",
							"// Test 10. Content-Encoding is gzip",
							"pm.test(\"Content-Encoding is gzip\", function () {",
							"    pm.expect(",
							"        pm.response.headers.get(\"Content-Encoding\")",
							"    ).to.eql(\"gzip\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				},
				"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
			},
			"response": []
		},
